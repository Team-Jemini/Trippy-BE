<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.mapper.account.AccountMapper">

    <resultMap id="accountMap" type="org.scoula.domain.account.AccountVO">
        <id property="accountId" column="account_id"/>
        <result property="userId" column="user_id"/>
        <result property="accountName" column="account_name"/>
        <result property="accountType" column="account_type"
                typeHandler="org.scoula.common.typehandler.account.AccountTypeTypeHandler"/>
        <result property="ownerId" column="owner_id"/>
        <result property="balance" column="balance"/>
        <result property="accountForeign" column="account_foreign"
                typeHandler="org.scoula.common.typehandler.account.AccountForeignTypeHandler"/>
        <result property="isDeleted" column="is_deleted"
                typeHandler="org.scoula.common.typehandler.account.DeletedStatusTypeHandler"/>
        <!-- BaseTime -->
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    <select id="getPersonalAccountDetail" resultType="org.scoula.domain.account.AccountVO">
        SELECT *
        FROM account
        WHERE account_id = #{accountId}
          and user_id = #{userId}
          and account_type = 'person'
    </select>
</mapper>