<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.mapper.exchange.ExchangeLogMapper">
    <resultMap id="exchangeLogMap" type="org.scoula.domain.exchange.ExchangeLogVO">
        <id property="exchangeId" column="exchange_id"/>
        <result property="accountId" column="account_id"/>
        <result property="exchangeAmountKrw" column="exchange_amount_krw"/>
        <result property="exchangeAmountForeign" column="exchange_amount_foreign"/>
        <result property="exchangeRateExchanged" column="exchange_rate_exchanged"/>
        <result property="exchangeNation" column="exchange_nation"/>
        <result property="currencyCode" column="currency_code"/>
        <result property="exchangeType" column="exchange_type"/>
        <result property="exchangeAt" column="exchange_at"/>
        <!-- BaseTime -->
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
</mapper>