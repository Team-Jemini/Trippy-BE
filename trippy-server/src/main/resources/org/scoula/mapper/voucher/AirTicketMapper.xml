<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.mapper.voucher.AirTicketMapper">

    <resultMap id="airTicketMap" type="org.scoula.domain.voucher.AirTicketVO">
        <id property="airlineId" column="airline_id"/>
        <result property="userId" column="user_id"/>
        <result property="reservationCode" column="reservation_code"/>
        <result property="airline" column="airline"/>
        <result property="flightNumber" column="flight_number"/>
        <result property="departureAirport" column="departure_airport"/>
        <result property="arrivalAirport" column="arrival_airport"/>
        <result property="departureCity" column="departure_city"/>
        <result property="arrivalCity" column="arrival_city"/>
        <result property="departureDate" column="departure_date"/>
        <result property="departureTime" column="departure_time"/>
        <result property="boardingTime" column="boarding_time"/>
        <result property="arrivalTime" column="arrival_time"/>
        <result property="terminal" column="terminal"/>
        <result property="gate" column="gate"/>
        <result property="seat" column="seat"/>
        <result property="baggage" column="baggage"/>
        <result property="baggageWeight" column="baggage_weight"/>
        <result property="passengerName" column="passenger_name"/>
        <result property="qrImg" column="qr_img"/>
        <result property="used" column="is_used"/>
        <result property="seatClass" column="seat_class"
                typeHandler="org.scoula.common.typehandler.voucher.SeatClassTypeHandler"/>
        <!-- BaseTime -->
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAllByUserIdOrderByDepartureDateDesc" resultMap="airTicketMap" parameterType="long">
        SELECT *
        FROM air_ticket
        WHERE user_id = #{userId}
        ORDER BY departure_date DESC
    </select>

    <select id="findById" resultMap="airTicketMap" parameterType="long">
        SELECT *
        FROM air_ticket
        WHERE airline_id = #{airlineId}
    </select>

</mapper>