<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.mapper.identification.PassportMapper">

    <resultMap id="passportMap" type="org.scoula.domain.identification.PassportVO">
        <id property="passportNumber" column="passport_number"/>
        <result property="userId" column="user_id"/>
        <result property="nameKr" column="name_kr"/>
        <result property="nameEn" column="name_en"/>
        <result property="birthDate" column="birth_date"/>
        <result property="gender" column="gender"/>
        <result property="countryCode" column="country_code"/>
        <result property="expireDate" column="expire_date"/>
        <!-- BaseTime -->
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByUserId" resultMap="passportMap">
        SELECT *
        FROM passport
        WHERE user_id = #{userId}
    </select>
</mapper>