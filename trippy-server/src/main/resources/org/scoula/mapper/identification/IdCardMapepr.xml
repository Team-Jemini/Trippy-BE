<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.mapper.identification.IdCardMapper">

    <resultMap id="idCardMap" type="org.scoula.domain.identification.IdCardVO">
        <id property="userId" column="user_id"/>
        <result property="idCardNum" column="id_card_num"/>
        <result property="idCardDate" column="id_card_date"/>
        <result property="name" column="name"/>
        <!-- BaseTime -->
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
</mapper>